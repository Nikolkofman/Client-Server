package bgu.spl.net.impl.stomp;

import bgu.spl.net.api.StompMessagingProtocol;
import bgu.spl.net.srv.ConnectionHandler;
import bgu.spl.net.srv.Connections;

import java.io.IOException;
import java.util.HashMap;
import java.util.Map;

public class StompMessagingProtocolImpl implements StompMessagingProtocol<String> {
    private int connectionId;
    private Connections<String> connections;
    private boolean shouldTerminate = false;

    public StompMessagingProtocolImpl(Connections<String> connections) {
        this.connections = connections;
    }

    @Override
    public void start(int connectionId, Connections<String> connections) {
        this.connectionId = connectionId;
        this.connections = connections;
    }

   @Override
    public String process(String message) {
        if (message == null || message.isBlank()) {
            return sendError("Empty or null message received", "UNKNOWN");
        }

        Map<String, String> headers = parseHeaders(message);
        String command = extractCommand(message);
        String body = extractBody(message);
        String response = null;

        if ("CONNECT".equals(command)) {
            response = processConnect(headers);
        } else if ("SUBSCRIBE".equals(command)) {
            response = processSubscribe(headers);
        } else if ("UNSUBSCRIBE".equals(command)) {
            response = processUnsubscribe(headers);
        } else if ("SEND".equals(command)) {
            response = processSend(headers, body);
        } else if ("DISCONNECT".equals(command)) {
            response = processDisconnect(headers);
        } else {
            response = sendError("Unknown STOMP command: " + command, message);
        }

        if (response != null && response.startsWith("ERROR")) {
            handleErrorResponse(response);
            response = null;
        }

        return response;
    }


    @Override
    public boolean shouldTerminate() {
        return shouldTerminate;
    }

    
    private void handleErrorResponse(String response) {
        try {
            ConnectionHandler<String> handler = connections.retrieveConnectionHandler(connectionId);
            if (handler != null) {
                handler.send(response);
                if (!response.contains("User already logged in")) {
                    connections.handleUserLogout(connectionId);
                }
                connections.disconnect(connectionId);
                handler.close();
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

  
    private String processConnect(Map<String, String> headers) {
        String username = headers.get("login");
        String password = headers.get("passcode");

        if (username == null || password == null) {
            return sendError("Missing login credentials", "CONNECT");
        }

        if (connections == null) {
            return sendError("Server error: Connections object is null", "CONNECT");
        }

        if (connections.checkUserExists(username)) {
            if (connections.isValidLogin(username, password)) {
                if (connections.isUserLoggedIn(username, password)) {
                    return sendError("User already logged in", "CONNECT");
                }
                connections.handleUserLogin(connectionId, username, password);
                return sendConnected();
            }
            return sendError("Invalid login credentials", "CONNECT");
        }

        
        connections.handleUserLogin(connectionId, username, password);
        return sendConnected();
    }

    
    private String processSubscribe(Map<String, String> headers) {
        String channel = headers.get("destination");
        String subscriptionId = headers.get("id");

        if (channel == null || subscriptionId == null) {
            return sendError("Missing destination or subscription ID", "SUBSCRIBE");
        }

        connections.addSubscription(channel, connectionId, Integer.parseInt(subscriptionId));
        return sendReceipt(headers.get("receipt"));
    }

}